DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3001
# Register ${BETTER_AUTH_URL}/api/auth/callback/google as an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate once with: openssl rand -base64 32
AI_CREDENTIALS_ENCRYPTION_KEY=

# Generate once with: echo "urn:uuid:$(uuidgen)"; keep stable for this installation.
OPENAI_OAUTH_HOST_ID=

# Shared web-search key for Market Discovery.
TAVILY_API_KEY=
